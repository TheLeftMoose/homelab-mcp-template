name: Auto-assign issues

on:
  issues:
    types: [opened]

permissions:
  issues: write

jobs:
  assign:
    if: github.event.issue.assignees[0] == null
    runs-on: ubuntu-latest
    steps:
      - name: Assign repo owner
        env:
          GH_TOKEN: {% raw %}${{ secrets.GITHUB_TOKEN }}{% endraw %}
        run: |
          gh issue edit "{% raw %}${{ github.event.issue.number }}{% endraw %}" \
            --repo "{% raw %}${{ github.repository }}{% endraw %}" \
            --add-assignee {{ repo_owner }}

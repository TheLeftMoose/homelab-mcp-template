"""FastMCP server exposing the {{ service_display_name }} tool surface.

This is a scaffold: keep the FastMCP, settings, and lazy connection
shape, then replace the example protocol/client/tool with service-
specific read-only tools.
"""

from __future__ import annotations

import asyncio
from collections.abc import Callable
from typing import Any, Protocol

from mcp.server.fastmcp import FastMCP

from .config import Settings


class ServiceHostProtocol(Protocol):
    """Subset of the upstream service client this server depends on."""

    host: str
    port: int
    protocol: str

    async def get_host_data(self) -> None: ...
    async def logout(self) -> None: ...


HostFactory = Callable[..., ServiceHostProtocol]


class PlaceholderHost:
    """Minimal placeholder client used until a real service client exists.

    TODO: Replace this with {{ vendor_library if vendor_library else 'a service-specific async client' }}.
    """

    def __init__(
        self,
        host: str,
        username: str,
        password: str,
        *,
        port: int = {{ default_port }},
        use_https: bool = True,
    ) -> None:
        self.host = host
        self.username = username
        self.password = password
        self.port = port
        self.protocol = "https" if use_https else "http"
        self.connected = False
        self.closed = False

    async def get_host_data(self) -> None:
        self.connected = True

    async def logout(self) -> None:
        self.closed = True


class ServiceConnection:
    """Lazy, single-client wrapper."""

    def __init__(
        self,
        settings: Settings,
        host_factory: HostFactory | None = None,
    ) -> None:
        self._settings = settings
        self._host_factory = host_factory or PlaceholderHost
        self._host: ServiceHostProtocol | None = None
        self._lock = asyncio.Lock()

    async def get(self) -> ServiceHostProtocol:
        async with self._lock:
            if self._host is None:
                host = self._host_factory(
                    self._settings.host,
                    self._settings.username,
                    self._settings.password,
                    port=self._settings.port,
                    use_https=self._settings.use_https,
                )
                await host.get_host_data()
                self._host = host
            return self._host

    async def close(self) -> None:
        async with self._lock:
            if self._host is not None:
                await self._host.logout()
                self._host = None


def build_server(connection: ServiceConnection) -> FastMCP:
    """Build the FastMCP server with scaffold tools registered."""

    mcp = FastMCP("{{ repo_name }}")

    @mcp.tool(
        description=(
            "Return basic {{ service_display_name }} endpoint information. "
            "TODO: Replace this scaffold tool with service-specific read-only tools."
        ),
    )
    async def {{ service_name | replace('-', '_') }}_get_endpoint_info() -> dict[str, Any]:
        host = await connection.get()
        return {
            "service": "{{ service_name }}",
            "display_name": "{{ service_display_name }}",
            "host": host.host,
            "port": host.port,
            "protocol": host.protocol,
            "todo": "replace scaffold tool with service-specific observations",
        }

    return mcp


def run() -> None:
    """Console-script entry point."""
    settings = Settings()  # type: ignore[call-arg]
    connection = ServiceConnection(settings)
    server = build_server(connection)
    server.run(transport="stdio")
